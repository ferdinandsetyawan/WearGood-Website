# Dapatkan Gemini API key dari Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mode AI: auto (pakai Gemini jika GEMINI_API_KEY terisi), gemini, atau mock (simulasi lokal)
AI_MODE=auto

# Model Gemini untuk Vision & Rekomendasi Outfit (Interactions API)
GEMINI_MODEL=gemini-3.5-flash-lite

# Model Gemini untuk Generasi Ilustrasi Item Pelengkap
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Aktifkan/nonaktifkan generasi gambar ilustrasi item (true/false)
GEMINI_ENABLE_IMAGE_GEN=true

# Batas waktu request AI (ms) dan fallback ke simulasi lokal bila terjadi gangguan
AI_TIMEOUT_MS=20000
# Waktu maksimum rekomendasi outfit sebelum memakai fallback lokal (ms)
AI_OUTFIT_TIMEOUT_MS=8000
AI_FALLBACK_ON_ERROR=true
